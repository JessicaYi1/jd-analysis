  "city": "北京",
  "raw_jd": "职责描述：负责大模型Agent框架的设计与落地...任职要求：熟悉Prompt工程...",
  "analysis": {
    "category": "AI产品经理",
    "reason": "JD核心职责完全围绕LLM落地、Agent设计以及算法团队对接，符合AI PM特征。",
    "hard_skills": ["Agent 链路设计", "Prompt 调优", "大模型技术边界认知"],
